# Fuerza el modo 100% local durante `npm test`, sin importar lo que haya en
# .env.local (Vite carga .env.local para TODOS los modos; este archivo
# sobreescribe esas dos variables solo para el modo "test" de Vitest).
# Así la suite de pruebas unitarias nunca depende de si tienes o no
# Supabase local corriendo en tu máquina.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
